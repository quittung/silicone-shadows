{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-outliner.invalid/schemas/record.schema.json",
  "title": "Batch Outliner published record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "vendor",
    "product_type",
    "name",
    "quality",
    "source"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "type": "integer" },
    "vendor": { "type": "string", "minLength": 1 },
    "product_type": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "quality": {
      "enum": ["unusable", "bad_perspective", "good"]
    },
    "source": {
      "enum": ["catalog", "alternative"]
    }
  }
}
